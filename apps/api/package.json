{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "vercel:api:build": "cd ../.. && bun run db:migrate && turbo build --filter=api",
    "start": "bun --env-file=../../.env src/main.ts",
    "dev": "bun --watch --env-file=../../.env src/main.ts",
    "start:prod": "node dist/main.js",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@fastify/multipart": "^10.0.0",
    "@nestjs/common": "^11.1.23",
    "@nestjs/core": "^11.1.23",
    "@nestjs/platform-fastify": "^11.1.23",
    "@polar-sh/sdk": "^0.48.1",
    "@workspace/assistant-tools": "workspace:*",
    "@workspace/auth": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/module-registry": "workspace:*",
    "@workspace/types": "workspace:*",
    "better-auth": "^1.6.11",
    "bullmq": "^5.77.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.2",
    "ioredis": "^5.10.1",
    "mongoose": "^9.6.2",
    "openai": "^6.39.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/node": "^25.1.0",
    "@workspace/typescript-config": "workspace:*",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
