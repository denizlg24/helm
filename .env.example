# Local development environment variables.

# ---------------------------------------------------------------------------
# apps/api - databases and infrastructure
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/helm
MONGO_URL=mongodb://mongo:mongo@localhost:27017/helm?authSource=admin
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=helm:

# ---------------------------------------------------------------------------
# apps/api - SMTP
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=helm@localhost

# ---------------------------------------------------------------------------
# apps/api - auth and app origins
# ---------------------------------------------------------------------------
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
HELM_AUTH_BASE_URL=http://localhost:3003
HELM_API_URL=http://localhost:3003
HELM_CONSOLE_URL=http://localhost:3002
HELM_WEB_URL=http://localhost:3000
HELM_DESKTOP_URL=http://localhost:1420

# ---------------------------------------------------------------------------
# apps/api - OAuth
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# ---------------------------------------------------------------------------
# apps/api - optional runtime settings
# ---------------------------------------------------------------------------
PORT=3003
HELM_COOKIE_DOMAIN=
HELM_SECURE_COOKIES=false
HELM_DESKTOP_CALLBACK_ORIGIN=
HELM_DEVICE_CLIENT_ID=helm-desktop

# ---------------------------------------------------------------------------
# apps/api - platform-managed LLM providers
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# apps/api - file storage (swappable backend adapter)
# ---------------------------------------------------------------------------
STORAGE_DRIVER=deniz-cloud
STORAGE_DENIZ_CLOUD_URL=https://storage.denizlg24.com
STORAGE_DENIZ_CLOUD_API_KEY=
STORAGE_MAX_UPLOAD_BYTES=1073741824

# ---------------------------------------------------------------------------
# apps/api - Polar billing (lazy; API boots without these)
# ---------------------------------------------------------------------------
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
POLAR_CHECKOUT_SUCCESS_URL=http://localhost:3002/billing/success?checkout={CHECKOUT_ID}
POLAR_PORTAL_RETURN_URL=http://localhost:3002/billing

# ---------------------------------------------------------------------------
# apps/web and apps/console
# ---------------------------------------------------------------------------
# Add NEXT_PUBLIC_HELM_API_URL to both the web and console Vercel projects.
# Add NEXT_PUBLIC_HELM_CONSOLE_URL and HELM_CONSOLE_URL to the web Vercel
# project.
NEXT_PUBLIC_HELM_API_URL=http://localhost:3003
NEXT_PUBLIC_HELM_CONSOLE_URL=http://localhost:3002

# ---------------------------------------------------------------------------
# apps/desktop
# ---------------------------------------------------------------------------
# These are used for local and packaged desktop builds, not Vercel hosting.
VITE_HELM_API_URL=http://localhost:3003
VITE_HELM_CONSOLE_URL=http://localhost:3002
TAURI_DEV_HOST=

# ---------------------------------------------------------------------------
# apps/marketing
# ---------------------------------------------------------------------------
# No environment variables currently required.
