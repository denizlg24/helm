{
  "name": "helm",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "desktop:build:custom": "bun scripts/desktop-custom-build.ts",
    "desktop:upload:artifacts": "bun scripts/deniz-cloud-upload-artifacts.ts",
    "desktop:report:result": "bun scripts/report-build-result.ts",
    "dev": "turbo dev",
    "lint": "turbo lint --cache=local:rw",
    "format": "turbo format",
    "check": "biome check --write .",
    "typecheck": "turbo typecheck",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "infra:logs": "docker compose logs -f",
    "db:generate": "bun --filter @workspace/db db:generate",
    "db:migrate": "bun --filter @workspace/db db:migrate",
    "db:push": "bun --filter @workspace/db db:push",
    "db:studio": "bun --filter @workspace/db db:studio",
    "vercel:api:build": "bun run db:migrate && turbo build --filter=api",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@workspace/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,md}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "packageManager": "bun@1.3.3",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
