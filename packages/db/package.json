{
  "name": "@workspace/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.21.0",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3"
  }
}
