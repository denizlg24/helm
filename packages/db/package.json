{
  "name": "@workspace/db",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/schema.ts --outdir ./dist --target node --format cjs --packages external",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "db:generate": "bun --env-file=../../.env x drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env x drizzle-kit migrate",
    "db:push": "bun --env-file=../../.env x drizzle-kit push",
    "db:studio": "bun --env-file=../../.env x drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.21.0",
    "postgres": "^3.4.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "@types/pg": "^8.15.6",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3"
  }
}
