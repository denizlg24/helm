{
  "name": "@workspace/auth",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/server.js",
  "types": "./src/server.ts",
  "exports": {
    "./server": {
      "types": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./permissions": {
      "types": "./src/permissions.ts",
      "default": "./dist/permissions.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./dist/types.js"
    },
    "./env": {
      "types": "./src/env.ts",
      "default": "./dist/env.js"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "default": "./dist/constants.js"
    }
  },
  "scripts": {
    "build": "bun build ./src/server.ts ./src/client.ts ./src/permissions.ts ./src/types.ts ./src/env.ts ./src/constants.ts --outdir ./dist --target node --format cjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@better-auth/api-key": "^1.6.11",
    "@better-auth/drizzle-adapter": "^1.6.11",
    "@workspace/db": "workspace:*",
    "@workspace/module-registry": "workspace:*",
    "@workspace/types": "workspace:*",
    "better-auth": "^1.6.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^7.0.2"
  }
}
